# Contact email used for polite-pool access to OpenAlex and Crossref APIs.
# Required by both APIs' etiquette policies to get faster, more reliable service.
OPENALEX_MAILTO=your_email@srmist.edu.in
CROSSREF_MAILTO=your_email@srmist.edu.in

# Optional: Unpaywall requires an email param for OA lookups (same etiquette policy).
UNPAYWALL_EMAIL=your_email@srmist.edu.in

# Optional: institutional API key if you have Scopus/Elsevier API access for
# supplementary cross-checking. Never required — manual Scopus exports are the
# primary source of truth for venue verification.
SCOPUS_API_KEY=

# Local paths (defaults shown; override only if relocating data/output folders)
DATA_DIR=./data
OUTPUTS_DIR=./outputs
